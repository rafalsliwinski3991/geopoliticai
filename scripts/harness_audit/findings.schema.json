{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "file", "line", "quote", "problem", "fix"],
        "properties": {
          "kind": {"type": "integer", "minimum": 1, "maximum": 6},
          "file": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "line": {"type": "integer", "minimum": 1},
          "quote": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "problem": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "fix": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    }
  }
}
