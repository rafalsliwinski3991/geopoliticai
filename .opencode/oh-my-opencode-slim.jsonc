{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@latest/oh-my-opencode-slim.schema.json",
  "preset": "opencode-go",
  "presets": {
    "opencode-go": {
      "orchestrator": {
        "model": "opencode-go/grok-4.6",
        "variant": "thinking",
        "skills": ["*"],
        "mcps": ["*", "!context7"]
      },
      "oracle": {
        "model": "opencode-go/gpt-5.6-luna",
        "variant": "max",
        "skills": ["simplify"],
        "mcps": []
      },
      "librarian": {
        "model": "opencode-go/deepseek-v4-flash-vision-exp",
        "variant": "high",
        "skills": [],
        "mcps": ["context7", "gh_grep"]
      },
      "explorer": {
        "model": "opencode-go/deepseek-v4-flash-vision-exp",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "designer": {
        "model": "opencode-go/glm-5.3-flash",
        "skills": [],
        "mcps": []
      },
      "fixer": {
        "model": "opencode-go/gpt-5.6-luna",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "observer": {
        "model": "opencode-go/gpt-5.6-luna",
        "variant": "high",
        "skills": [],
        "mcps": []
      },
      "council": {
        "model": "opencode-go/gpt-5.6-luna",
        "variant": "high"
      }
    }
  },
  "council": {
    "default_preset": "default",
    "presets": {
      "default": {
        "alpha": {
          "model": "opencode-go/gpt-5.6-luna"
        },
        "beta": {
          "model": "opencode-go/glm-5.3-flash"
        },
        "gamma": {
