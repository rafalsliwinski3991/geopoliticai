{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "critic",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow"
        }
      ]
    }
  }
}
