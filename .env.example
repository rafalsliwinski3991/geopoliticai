# Required
OPENAI_API_KEY=sk-...
BRAVE_SEARCH_KEY=BSA...

# Basic auth for the web UI (prod only)
AUTH_USER=admin
AUTH_PASSWORD=changeme

# Optional - logging
LOG_LEVEL=INFO

# Optional - path to the built frontend shell served by the API
# FRONTEND_HTML_PATH=/app/frontend/index.html

# DB - required by the API. Conversation threads live in the LangGraph
# Postgres checkpointer; without DATABASE_URL the API refuses to start.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://geopoliticai:${POSTGRES_PASSWORD}@postgres:5432/geopoliticai

# Tracing (optional; an unset endpoint disables tracing entirely).
# ARIZE_PLATFORM selects PHOENIX (self-hosted, uses PHOENIX_COLLECTOR_ENDPOINT)
# or AX (Arize cloud, uses ARIZE_COLLECTOR_ENDPOINT, ARIZE_SPACE_ID, ARIZE_API_KEY).
ARIZE_PLATFORM=PHOENIX
ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1
ARIZE_SPACE_ID=your-arize-space-id
ARIZE_PROJECT_NAME=geopoliticai-expert
ARIZE_API_KEY=sk-...
PHOENIX_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
