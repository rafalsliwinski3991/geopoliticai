# Required
OPENAI_API_KEY=sk-...
BRAVE_SEARCH_KEY=BSA...

# Basic auth for the web UI (prod only)
AUTH_USER=admin
AUTH_PASSWORD=changeme

# Set to your VPS IP or domain (used for CORS)
CORS_ALLOW_ORIGINS=http://your-vps-ip

# Optional - LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=geopoliticai

# Optional - tuning
LOG_LEVEL=INFO
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=1200
API_RATE_LIMIT_REQUESTS=20
API_RATE_LIMIT_WINDOW_SECONDS=60

# DB
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://geopoliticai:${POSTGRES_PASSWORD}@postgres:5432/geopoliticai

# Self-hosted Phoenix tracing (optional; unset disables tracing entirely)
PHOENIX_COLLECTOR_ENDPOINT= http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=geopoliticai-expert
PHOENIX_PORT=6006