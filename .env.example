# Required
OPENAI_API_KEY=sk-...
BRAVE_SEARCH_KEY=BSA...
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Basic auth for the web UI (prod only)
AUTH_USER=admin
AUTH_PASSWORD=changeme

# Django identity service (web_backend). DJANGO_SECRET_KEY is required;
# generate one with `python -c "import secrets; print(secrets.token_urlsafe(64))"`.
DJANGO_SECRET_KEY=changeme
# Shared with agentic_backend: this is the key that signs the access tokens
# the API verifies. Must be the same value in both services.
JWT_SIGNING_KEY=changeme
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=politicalagent.eu,www.politicalagent.eu,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://politicalagent.eu,https://www.politicalagent.eu
# `console` in development, `smtp` (the default) in production.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Q20: the existing domain mailbox over SMTP.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@politicalagent.eu

# Dev port for the Django identity service
ACCOUNTS_PORT=8083

# Optional - logging
LOG_LEVEL=INFO

# DB - required by the API. Conversation threads live in the LangGraph
# Postgres checkpointer; without DATABASE_URL the API refuses to start.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://geopoliticai:${POSTGRES_PASSWORD}@postgres:5432/geopoliticai

# Tracing (optional; an unset endpoint disables tracing entirely).
# ARIZE_PLATFORM selects PHOENIX (self-hosted, uses PHOENIX_COLLECTOR_ENDPOINT)
# or AX (Arize cloud, uses ARIZE_COLLECTOR_ENDPOINT, ARIZE_SPACE_ID, ARIZE_API_KEY).
ARIZE_PLATFORM=PHOENIX
ARIZE_COLLECTOR_ENDPOINT=https://otlp.arize.com/v1
ARIZE_SPACE_ID=your-arize-space-id
ARIZE_PROJECT_NAME=geopoliticai-expert
ARIZE_API_KEY=sk-...
PHOENIX_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
